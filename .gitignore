# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.log
.eslintcache

# local data / dumps (never commit user data)
*.dump
*.sql.gz
*.sqlite
/data/

# local-only reports (session artifacts, not part of the codebase)
SECURITY-AUDIT-REPORT.txt
posthog-setup-report.md
docs/design-references/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# claude code
.claude/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local
